---
// src/pages/en/self-hosting/configuration-generator.astro
//
// FORWARDER ONLY. The Configuration Generator itself now lives in the
// documentation collection at src/content/docs/en/reference/generator.mdoc,
// with normal metadata, search indexing, prev/next and sidebar participation.
//
// This file is all that remains of the old custom route, and it exists because
// Astro's static redirects cannot carry a query string or a fragment: a
// bookmarked /en/self-hosting/configuration-generator/?...#apply-configuration
// would otherwise arrive with every selection dropped. The forwarding target
// is computed by src/components/config-generator/legacy-route.ts, which has
// its own tests. config/redirects.mjs skips the default locale for this slug,
// so this URL is a page and not also a redirect; the other sixteen locales
// redirect straight to the new route.
import { GENERATOR_ROUTE } from "../../../components/config-generator/legacy-route";

const title = "Configuration generator";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>{title}</title>
    <link rel="canonical" href={GENERATOR_ROUTE} />
    <noscript>
      <meta http-equiv="refresh" content={`0; url=${GENERATOR_ROUTE}`} />
    </noscript>
  </head>
  <body>
    <p>
      The configuration generator has moved to
      <a href={GENERATOR_ROUTE}>{GENERATOR_ROUTE}</a>.
    </p>
    <script>
      import { generatorTarget } from "../../../components/config-generator/legacy-route";

      window.location.replace(generatorTarget(window.location.search, window.location.hash));
    </script>
  </body>
</html>
