---
// src/pages/404.astro
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Icon } from '@astrojs/starlight/components';
import { i18nConfig } from '../../config/i18n.mjs';
// Inline the SVG (raw) so its theme-aware CSS can respond to Starlight's
// [data-theme] toggle. Rendered as <img>, the SVG is isolated and can only
// react to the OS prefers-color-scheme, not the on-site light/dark switch.
// The asset is labelled (role="img" + aria-label); the heading and message
// carry the meaning on their own if it fails to render.
// set:html is safe here because this is a static, repo-controlled asset with
// no user input; do not template untrusted data into it without sanitizing.
import notFoundSvg from '../assets/img/404-illustration.svg?raw';

// This page is emitted as a single static /404.html that the host serves for
// every unmatched route, in every language. There is therefore no build-time
// locale to key off. Instead we ship the translated strings for every locale
// and let a tiny inline script below pick the right one from the URL path at
// runtime. English is rendered server-side as the no-JS / fallback default.
const i18nModules = import.meta.glob('../content/i18n/*.json', { eager: true });
const strings: Record<string, Record<string, string>> = {};
for (const [path, mod] of Object.entries(i18nModules)) {
  const code = path.split('/').pop()!.replace('.json', '');
  strings[code] = (mod as { default?: Record<string, string> }).default ?? (mod as Record<string, string>);
}

const defaultLocale = i18nConfig.defaultLocale;
const localeCodes = Object.keys(i18nConfig.locales);
const en = strings[defaultLocale];
// Per-key fallback to English so a locale missing a key never renders blank.
const tr = (code: string, key: string) => strings[code]?.[key] ?? en[key];

const t: Record<string, Record<string, string>> = {};
for (const code of localeCodes) {
  const { lang, dir } = i18nConfig.locales[code];
  t[code] = {
    lang,
    dir,
    title: tr(code, 'notFound.title'),
    message: tr(code, 'notFound.message'),
    search: tr(code, 'notFound.search'),
    gettingStarted: tr(code, 'notFound.gettingStarted'),
    apiDocs: tr(code, 'notFound.apiDocs'),
    selfHosting: tr(code, 'notFound.selfHosting'),
    goToApp: tr(code, 'notFound.goToApp'),
  };
}

const d = t[defaultLocale]; // English defaults for server-rendered output
const docLink = (slug: string) => `/${defaultLocale}/${slug}/`;

// The three places a docs visitor most likely meant to land. data-doclink is
// re-pointed to the visitor's locale at runtime.
const links = [
  { key: 'gettingStarted', slug: 'start' },
  { key: 'apiDocs', slug: 'api' },
  { key: 'selfHosting', slug: 'self-hosting' },
];
---

{/* The site's own hero: title and message on the left, the burning note on
    the right at desktop, stacked on phones. Same component the homepage uses,
    so the two pages share one visual family. */}
<StarlightPage
  frontmatter={{
    title: d.title,
    template: 'splash',
    hero: { title: d.title, tagline: d.message, image: { html: notFoundSvg } },
  }}
>
  <div class="not-found not-content">
    {/* One real action: the visitor was looking for a specific page. The
        button opens Starlight's own search dialog (Pagefind, built output
        only). Hidden by the script below if no search is on the page. */}
    <button type="button" class="nf-search" data-nf-search hidden>
      <Icon name="magnifier" size="1.1em" />
      <span data-i18n="search">{d.search}</span>
      <kbd aria-hidden="true">⌘K</kbd>
    </button>

    <nav class="nf-links" aria-label="Likely destinations">
      {links.map((l) => (
        <a data-doclink={l.slug} data-i18n={l.key} href={docLink(l.slug)}>{d[l.key]}</a>
      ))}
      <a class="nf-app" href="https://onetimesecret.com/">
        <span data-i18n="goToApp">{d.goToApp}</span>
        <Icon name="external" size="0.875em" />
      </a>
    </nav>
  </div>
</StarlightPage>

<script is:inline define:vars={{ i18n: t, codes: localeCodes, fallback: defaultLocale }}>
  // Localise the static 404 to the visitor's language, inferred from the first
  // path segment (e.g. /fr/missing -> "fr"). Falls back to the default locale
  // for unknown segments. Runs once on load; no-JS visitors keep the English
  // server-rendered copy.
  (function () {
    var seg = location.pathname.split('/').filter(Boolean)[0];
    var loc = codes.indexOf(seg) !== -1 ? seg : fallback;
    var s = i18n[loc] || i18n[fallback];
    if (!s) return;

    var root = document.documentElement;
    root.setAttribute('lang', s.lang);
    root.setAttribute('dir', s.dir);

    var h1 = document.getElementById('_top');
    if (h1) h1.textContent = s.title;
    var tagline = document.querySelector('.hero .tagline');
    if (tagline) tagline.textContent = s.message;

    var sep = document.title.indexOf('|');
    document.title = sep > -1 ? s.title + ' ' + document.title.slice(sep) : s.title;

    document.querySelectorAll('[data-i18n]').forEach(function (el) {
      var key = el.getAttribute('data-i18n');
      if (s[key]) el.textContent = s[key];
    });

    document.querySelectorAll('[data-doclink]').forEach(function (a) {
      a.setAttribute('href', '/' + loc + '/' + a.getAttribute('data-doclink') + '/');
    });

    // Search: delegate to the header's dialog so there is one search, not two.
    var opener = document.querySelector('site-search button');
    var btn = document.querySelector('[data-nf-search]');
    if (opener && btn) {
      btn.hidden = false;
      btn.addEventListener('click', function () { opener.click(); });
      if (!/Mac|iPhone|iPad/.test(navigator.platform)) {
        var kbd = btn.querySelector('kbd');
        if (kbd) kbd.textContent = 'Ctrl K';
      }
    }
  })();
</script>

<style>
  .not-found {
    max-width: 36rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    padding-block: 0.5rem 3rem;
  }

  /* Looks like the header's search field so it reads as the same control. */
  .nf-search {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    max-width: 24rem;
    padding: 0.7rem 0.9rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    background: var(--sl-color-black);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    cursor: pointer;
    text-align: start;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .nf-search:hover,
  .nf-search:focus-visible {
    border-color: var(--sl-color-gray-2);
    color: var(--sl-color-white);
  }
  .nf-search span {
    flex: 1;
  }
  .nf-search kbd {
    font-family: inherit;
    font-size: var(--sl-text-2xs);
    color: var(--sl-color-gray-3);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    padding: 0.1rem 0.4rem;
  }

  .nf-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.75rem;
    font-size: var(--sl-text-base);
  }
  .nf-links a {
    color: var(--sl-color-text-accent);
    text-decoration: none;
    text-underline-offset: 0.25em;
  }
  .nf-links a:hover,
  .nf-links a:focus-visible {
    text-decoration: underline;
  }
  .nf-app {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--sl-color-gray-2) !important;
  }

  /* The hero's own styles size the html image; keep the note from dwarfing
     the copy on wide screens and give it room on phones. */
  :global(.hero .hero-html svg) {
    width: 100%;
    max-width: 30rem;
    height: auto;
  }
</style>
