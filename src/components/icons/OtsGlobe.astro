---
// src/components/icons/OtsGlobe.astro
//
// Regional globe icons, the same drawings the Onetime Secret app and the
// marketing site use for jurisdictions. Drawn in currentColor, so they follow
// the surrounding text colour in light and dark themes.
//
// The SVGs in src/assets/icons/ots/ are GENERATED in onetimesecret/onetimesecret
// by scripts/globes/build.mjs (which writes them to scripts/globes/out/). Add or
// change globes in that repo's scripts/globes/presets.mjs and copy the output
// here, dropping the `ots-` filename prefix, rather than editing the paths.
//
//   <OtsGlobe name="earth-canada" />
//   <OtsGlobe name="earth-european-union" size="2rem" label="European Union" />
//   {% globe name="earth-canada" /%}    (in .mdoc content)
//
// Without a label the icon is decorative and hidden from assistive technology.

interface Props {
  name: string;
  size?: string;
  label?: string;
  class?: string;
}

const globes = import.meta.glob<string>("../../assets/icons/ots/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

const byName = Object.fromEntries(
  Object.entries(globes).map(([path, svg]) => [
    path.slice(path.lastIndexOf("/") + 1, -".svg".length),
    svg,
  ]),
);

const { name, size = "1em", label, class: className } = Astro.props;
const svg = byName[name];

if (!svg) {
  throw new Error(
    `OtsGlobe: no globe named "${name}". Available: ${Object.keys(byName).sort().join(", ")}`,
  );
}
---

<span
  class:list={["ots-globe", className]}
  style={{ "--ots-globe-size": size }}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  ><Fragment set:html={svg} /></span
>

<style>
  .ots-globe {
    display: inline-block;
    width: var(--ots-globe-size);
    height: var(--ots-globe-size);
    vertical-align: -0.125em;
    line-height: 0;
  }
  .ots-globe :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
