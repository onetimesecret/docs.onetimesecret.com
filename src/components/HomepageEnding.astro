---
interface Props {
  variant?: 'quiet' | 'envelope' | 'receipt';
}

const { variant = 'receipt' } = Astro.props;
---

<div class="homepage-ending" data-homepage-ending>
  <section class="ending quiet" data-ending="quiet" hidden={variant !== 'quiet'} aria-label="Security information">
    <a href="/en/security/">Questions about security? <span aria-hidden="true">→</span></a>
  </section>

  <section class="ending envelope" data-ending="envelope" hidden={variant !== 'envelope'} aria-label="How we protect your data">
    <svg viewBox="0 0 240 180" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="M30 75 120 15 210 75v85H30Z" />
      <path d="m30 75 90 60 90-60M30 160l63-43m117 43-63-43" />
      <path d="M65 97V48h110v49" />
    </svg>
    <p class="closing-line">A little less left behind.</p>
    <a href="/en/security/data-protection/">How we protect your data <span aria-hidden="true">→</span></a>
  </section>

  <section class="ending receipt" data-ending="receipt" hidden={variant !== 'receipt'} aria-label="How we protect your data">
    <div class="tiny-receipt">
      <span class="receipt-mark" data-receipt-mark aria-hidden="true">OTS / 7A3F</span>
      <p>There was a<br />secret here.</p>
      <span class="receipt-rule" aria-hidden="true"></span>
    </div>
    <a href="/en/security/data-protection/">How we protect your data <span aria-hidden="true">→</span></a>
  </section>

  <nav class="help-links" aria-label="More help">
    <a href="/en/share/what-recipients-see/">Received a link?</a>
    <a href="/en/share/when-a-link-doesnt-work/">Link not working?</a>
    <a href="/en/security/vulnerability-disclosure/">Report a security issue</a>
    <a href="/en/start/glossary/">Glossary</a>
  </nav>
</div>

<script>
  function refreshReceiptMark() {
    document.querySelectorAll('[data-receipt-mark]').forEach((mark) => {
      const bytes = crypto.getRandomValues(new Uint8Array(2));
      const identifier = Array.from(bytes, (byte) =>
        byte.toString(16).padStart(2, '0'),
      ).join('').toUpperCase();
      mark.textContent = `OTS / ${identifier}`;
    });
  }

  refreshReceiptMark();
  document.addEventListener('astro:after-swap', refreshReceiptMark);
</script>

<style>
  .homepage-ending {
    margin-block-start: clamp(4rem, 8vw, 7rem);
  }
  .ending {
    min-block-size: 22rem;
    padding: 3rem 1rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    text-align: center;
  }
  .ending[hidden] {
    display: none;
  }
  .ending > *, .tiny-receipt > *, .help-links > * {
    margin: 0;
  }
  .ending a {
    font-size: 0.9rem;
  }
  .envelope svg {
    width: 12rem;
    max-width: 100%;
    color: var(--sl-color-gray-4);
  }
  .closing-line {
    font-size: 1.25rem;
    color: var(--sl-color-gray-2);
  }
  .tiny-receipt {
    width: 9rem;
    padding: 1.25rem 1rem 1.75rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-text);
    font-family: var(--sl-font-mono);
    transform: rotate(-4deg);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 90% 96%, 80% 100%, 70% 96%, 60% 100%, 50% 96%, 40% 100%, 30% 96%, 20% 100%, 10% 96%, 0 100%);
  }
  .receipt-mark {
    display: block;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    color: var(--sl-color-gray-2);
  }
  .tiny-receipt p {
    margin-block: 1.25rem;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .receipt-rule {
    display: block;
    border-block-start: 1px dashed var(--sl-color-gray-3);
  }
  .help-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.75rem;
    max-inline-size: 44rem;
    margin: 1rem auto 0;
    padding-block: 1.5rem 3rem;
    font-size: 0.8rem;
  }
  .help-links a {
    color: var(--sl-color-gray-2);
  }
</style>
