---
/**
 * Sidebar override: Starlight's default sidebar, preceded by a section card
 * that only renders inside the mobile drawer (below Starlight's 50rem
 * breakpoint, where the header's section links and theme/language selects are
 * hidden).
 *
 * The card carries the same four links as the header — see nav-links.ts —
 * plus the theme and language selects, so a phone reader does not have to
 * scroll past the whole 70-page sidebar to switch language. MobileMenuFooter
 * is overridden alongside this to drop the duplicate selects it would
 * otherwise render at the bottom.
 */
import Default from '@astrojs/starlight/components/Sidebar.astro';
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import { Icon } from '@astrojs/starlight/components';
import { getNavLinks, isCurrentSection } from './nav-links';

const links = getNavLinks(Astro.currentLocale);
const pathname = Astro.url.pathname;
---

{/* The md:sl-hidden gate must sit on an element with no display rule of its
    own: Starlight's utilities live in @layer starlight.utils, and any unlayered
    declaration on the same element outranks them. */}
<div class="md:sl-hidden">
<div class="mobile-sections">
	<nav class="section-card" aria-label={Astro.locals.t('nav.label.guides')}>
		<ul role="list">
			{
				links.map((link) => {
					const current = isCurrentSection(link, pathname);
					return (
						<li>
							<a
								href={link.href}
								aria-label={Astro.locals.t(link.ariaKey)}
								aria-current={current ? 'page' : undefined}
								target={link.external ? '_blank' : undefined}
								rel={link.external ? 'noopener noreferrer' : undefined}
							>
								<Icon name={link.icon} class="icon" />
								<span>{Astro.locals.t(link.labelKey)}</span>
								{link.external && <Icon name="external" class="external" />}
							</a>
						</li>
					);
				})
			}
		</ul>
	</nav>
	<div class="preferences sl-flex">
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>
</div>

<Default><slot /></Default>

<style>
	.mobile-sections {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.section-card {
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 0.5rem;
		background-color: var(--sl-color-bg-sidebar);
		padding: 0.25rem;
	}

	.section-card ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.section-card a {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.625rem 0.75rem;
		border-radius: 0.375rem;
		color: var(--sl-color-text);
		font-size: var(--sl-text-base);
		font-weight: 600;
		line-height: 1.4;
		text-decoration: none;
	}

	.section-card a:hover {
		color: var(--sl-color-white);
		background-color: var(--sl-color-gray-6);
	}

	/* Same treatment Starlight gives the current sidebar link: accent-low
	   background with accent-text ink clears AA in both themes. */
	.section-card a[aria-current='page'] {
		color: var(--sl-color-text-invert);
		background-color: var(--sl-color-text-accent);
	}

	.section-card .icon {
		flex-shrink: 0;
		font-size: 1.25rem;
		color: var(--sl-color-gray-2);
	}

	.section-card a[aria-current='page'] .icon,
	.section-card a:hover .icon {
		color: inherit;
	}

	.section-card .external {
		margin-inline-start: auto;
		font-size: 0.875rem;
		opacity: 0.6;
	}

	.preferences {
		justify-content: flex-end;
		flex-wrap: wrap;
		column-gap: 1rem;
		row-gap: 0.25rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--sl-color-hairline-light);
	}
</style>
