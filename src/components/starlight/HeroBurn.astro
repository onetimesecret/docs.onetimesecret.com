<style>
	@layer starlight.core {
		.hero-burn {
			--hb-paper: #ece8e3;
			--hb-line: #9b958f;
			--hb-char: #f6b27e;
			--hb-ember: #dc4a22;
			--hb-edge: #ffb08a;
			--hb-ash: #8b8580;
			--hb-spark: #23b5dd;
			position: absolute;
			inset-block-start: -1.5rem;
			inset-inline-end: 0;
			width: min(26rem, 42%);
			opacity: 0.24;
			pointer-events: none;
			z-index: -1;
			/* Frame the upper-right of the title. Fade the lower edge before the
			 * tagline and actions, and the left edge as it approaches the copy. */
			-webkit-mask-image: linear-gradient(to right, transparent 0%, #000 55%), linear-gradient(to bottom, #000 40%, transparent 90%);
			-webkit-mask-composite: source-in;
			mask-image: linear-gradient(to right, transparent 0%, #000 55%), linear-gradient(to bottom, #000 40%, transparent 90%);
			mask-composite: intersect;
		}

		:global([data-theme='light']) .hero-burn {
			--hb-paper: #ffffff;
			--hb-line: #c9c4bf;
			--hb-char: #f0c39e;
			--hb-ash: #b8b2ac;
			opacity: 0.36;
		}

		:global([data-theme='light']) .hero-burn .paper {
			stroke: #e2ddd8;
			stroke-width: 1.5;
		}

		svg {
			display: block;
			width: 100%;
			height: auto;
			overflow: visible;
		}

		.paper {
			fill: var(--hb-paper);
		}

		.lines line {
			stroke: var(--hb-line);
			stroke-width: 8;
			stroke-linecap: round;
		}

		.edge-glow,
		.edge {
			fill: none;
			stroke-linejoin: round;
		}

		.edge-glow {
			stroke: var(--hb-ember);
			stroke-width: 10;
		}

		.edge {
			stroke: var(--hb-edge);
			stroke-width: 2.5;
		}

		.ember {
			fill: var(--hb-ember);
		}

		.ash {
			fill: var(--hb-ash);
		}

		.ember {
			filter: drop-shadow(0 0 3px var(--hb-ember));
		}

		.spark {
			fill: var(--hb-spark);
		}

		.embers > * {
			transform-box: fill-box;
			transform-origin: center;
			animation: hb-rise var(--d, 8s) ease-out var(--l, 0s) infinite;
		}

		@keyframes hb-rise {
			0% {
				transform: translate(0, 0);
				opacity: 0;
			}
			15%,
			70% {
				opacity: 1;
			}
			100% {
				transform: translate(26px, -34px);
				opacity: 0;
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.embers > * {
				animation: none;
			}
		}

		/* On narrow screens, keep the smaller note above the title instead of
		 * moving it behind the actions. */
		@media (max-width: 50rem) {
			.hero-burn {
				width: min(18rem, 65%);
				inset-block-start: -2.75rem;
				opacity: 0.12;
			}
		}
	}
</style>
