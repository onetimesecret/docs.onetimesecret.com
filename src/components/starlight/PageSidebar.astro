---
/**
 * PageSidebar override: Starlight's default (mobile TOC bar below 72rem, right
 * sidebar panel above it) with the TextProv controls added in both places.
 *
 * - Wide viewports: TextProvControls.astro renders as a block above "On this
 *   page". The panel is fixed and scrolls on its own, so the controls never move
 *   the article.
 * - Below 72rem: Starlight pins the TOC `<details>` in a fixed bar under the
 *   header. The compact controls overlay the end of that bar, at the same
 *   height, so they cost no vertical space either. The bar's summary gets
 *   end padding so the current-heading text ellipsises before the overlay.
 *
 * The controls follow the table of contents: a page with `tableOfContents:
 * false` (the splash homepages) has no right sidebar and no controls, and a
 * preference saved on another page still applies to it (TextProvMarker.astro).
 * `SHOW_TEXTPROV_TOGGLE=false` at build time hides the controls everywhere.
 *
 * The right-sidebar-panel styles are Starlight's own, copied because a
 * component override replaces its scoped stylesheet too.
 */
import MobileTableOfContents from '@astrojs/starlight/components/MobileTableOfContents.astro';
import TableOfContents from '@astrojs/starlight/components/TableOfContents.astro';
import TextProvControls from './TextProvControls.astro';
import { showTextProvToggle } from '../../../config/textprov.mjs';

const { toc } = Astro.locals.starlightRoute;
const controls = showTextProvToggle();
---

{
	toc && (
		<>
			<div class:list={['lg:sl-hidden', { 'textprov-host': controls }]}>
				<MobileTableOfContents />
				{controls && (
					<div class="textprov-bar print:hidden">
						<TextProvControls id="bar" compact />
					</div>
				)}
			</div>
			<div class="right-sidebar-panel sl-hidden lg:sl-block">
				<div class="sl-container">
					{controls && <TextProvControls id="panel" />}
					<TableOfContents />
				</div>
			</div>
		</>
	)
}

<style>
	@layer starlight.core {
		.right-sidebar-panel {
			padding: 1rem var(--sl-sidebar-pad-x);
		}
		.sl-container {
			width: calc(var(--sl-sidebar-width) - 2 * var(--sl-sidebar-pad-x));
		}
		.right-sidebar-panel :global(h2) {
			color: var(--sl-color-white);
			font-size: var(--sl-text-h5);
			font-weight: 600;
			line-height: var(--sl-line-height-headings);
			margin-bottom: 0.5rem;
		}
		.right-sidebar-panel :global(:where(a)) {
			display: block;
			font-size: var(--sl-text-xs);
			text-decoration: none;
			color: var(--sl-color-gray-3);
			overflow-wrap: anywhere;
		}
		.right-sidebar-panel :global(:where(a):hover) {
			color: var(--sl-color-white);
		}
		@media (min-width: 72rem) {
			.sl-container {
				max-width: calc(
					(
						(
								100vw - var(--sl-sidebar-width) - 2 * var(--sl-content-pad-x) - 2 *
									var(--sl-sidebar-pad-x)
							) * 0.25 /* MAGIC NUMBER 🥲 */
					)
				);
			}
		}
	}

	/* Geometry copied from MobileTableOfContents: same top edge and height as
	   the fixed TOC bar, pinned to its end. One step above the bar's z-index so
	   the overlay paints over the summary; the popover uses the top layer. */
	.textprov-bar {
		--textprov-bar-width: 9rem;
		position: fixed;
		z-index: calc(var(--sl-z-index-toc) + 1);
		top: calc(var(--sl-nav-height) - 1px);
		inset-inline-end: 0;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		block-size: var(--sl-mobile-toc-height);
		inline-size: var(--textprov-bar-width);
		padding-inline-end: 0.5rem;
		background-color: var(--sl-color-bg-nav);
		border-block-end: 1px solid var(--sl-color-hairline-shade);
	}
	/* The summary's current-heading text would otherwise run under the overlay. */
	.textprov-host :global(#starlight__on-this-page--mobile) {
		padding-inline-end: 9rem;
	}
</style>
