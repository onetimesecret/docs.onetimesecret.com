---
/**
 * PageSidebar override: Starlight's default (mobile TOC bar below 72rem, right
 * sidebar panel above it) with the page-actions dropdown and the TextProv
 * controls added in both places.
 *
 * - Wide viewports: the "Copy page" dropdown (starlight-llm-actions) sits at
 *   the top of the right sidebar, then TextProvControls.astro as a block above
 *   "On this page". The panel is fixed and scrolls on its own, so neither
 *   moves the article.
 * - Below 72rem: Starlight pins the TOC `<details>` in a fixed bar under the
 *   header. The dropdown (icon only) and the compact controls overlay the end
 *   of that bar, at the same height, so they cost no vertical space either.
 *   The bar's summary gets end padding so the current-heading text ellipsises
 *   before the overlay.
 *
 * The dropdown is one element in both layouts: the plugin's script wires only
 * the first `.page-actions` on the page, so it cannot be rendered twice. The
 * `.page-tools` wrapper is a fixed bar on narrow viewports and a static block
 * above the panel on wide ones. The TextProv switch has no such limit
 * (display.ts wires every switch), so it keeps its two instances.
 *
 * Everything follows the table of contents: a page with `tableOfContents:
 * false` (the splash homepages) has no right sidebar, no dropdown and no
 * controls, and a TextProv preference saved on another page still applies to
 * it (TextProvMarker.astro). `SHOW_TEXTPROV_TOGGLE=false` at build time hides
 * the controls everywhere; the dropdown stays.
 *
 * The right-sidebar-panel styles are Starlight's own, copied because a
 * component override replaces its scoped stylesheet too.
 */
import MobileTableOfContents from '@astrojs/starlight/components/MobileTableOfContents.astro';
import TableOfContents from '@astrojs/starlight/components/TableOfContents.astro';
import PageActions from 'starlight-llm-actions/components/PageActions.astro';
import TextProvControls from './TextProvControls.astro';
import { showTextProvToggle } from '../../../config/textprov.mjs';

const { toc } = Astro.locals.starlightRoute;
const controls = showTextProvToggle();
---

{
	toc && (
		<>
			<div class:list={['lg:sl-hidden', 'toc-host', { 'textprov-host': controls }]}>
				<MobileTableOfContents />
			</div>
			<div class="page-tools print:hidden">
				<div class="sl-container">
					<PageActions />
					{controls && (
						<div class="lg:sl-hidden">
							<TextProvControls id="bar" compact />
						</div>
					)}
				</div>
			</div>
			<div class="right-sidebar-panel sl-hidden lg:sl-block">
				<div class="sl-container">
					{controls && <TextProvControls id="panel" />}
					<TableOfContents />
				</div>
			</div>
		</>
	)
}

<style>
	@layer starlight.core {
		.right-sidebar-panel {
			padding: 1rem var(--sl-sidebar-pad-x);
		}
		.sl-container {
			width: calc(var(--sl-sidebar-width) - 2 * var(--sl-sidebar-pad-x));
		}
		.right-sidebar-panel :global(h2) {
			color: var(--sl-color-white);
			font-size: var(--sl-text-h5);
			font-weight: 600;
			line-height: var(--sl-line-height-headings);
			margin-bottom: 0.5rem;
		}
		.right-sidebar-panel :global(:where(a)) {
			display: block;
			font-size: var(--sl-text-xs);
			text-decoration: none;
			color: var(--sl-color-gray-3);
			overflow-wrap: anywhere;
		}
		.right-sidebar-panel :global(:where(a):hover) {
			color: var(--sl-color-white);
		}
		@media (min-width: 72rem) {
			.sl-container {
				max-width: calc(
					(
						(
								100vw - var(--sl-sidebar-width) - 2 * var(--sl-content-pad-x) - 2 *
									var(--sl-sidebar-pad-x)
							) * 0.25 /* MAGIC NUMBER 🥲 */
					)
				);
			}
		}
	}

	/* Narrow viewports: geometry copied from MobileTableOfContents, same top
	   edge and height as the fixed TOC bar, pinned to its end. One step above
	   the bar's z-index so the overlay paints over the summary; the dropdown
	   menu and the TextProv popover stack inside or above it. The bar sizes to
	   its content so a longer localised switch label is never clipped. */
	.page-tools {
		position: fixed;
		z-index: calc(var(--sl-z-index-toc) + 1);
		top: calc(var(--sl-nav-height) - 1px);
		inset-inline-end: 0;
		block-size: var(--sl-mobile-toc-height);
		padding-inline: 0.5rem;
		background-color: var(--sl-color-bg-nav);
		border-block-end: 1px solid var(--sl-color-hairline-shade);
	}
	.page-tools .sl-container {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.25rem;
		width: auto;
		block-size: 100%;
	}
	/* Icon-only trigger in the bar, shaped like the TextProv info button next
	   to it. The accessible name is the plugin's aria-label. */
	.page-tools :global(.page-actions-trigger) {
		inline-size: 2rem;
		block-size: 2rem;
		padding: 0;
		justify-content: center;
		border: 0;
		border-radius: 50%;
		color: var(--sl-color-gray-3);
	}
	.page-tools :global(.page-actions-trigger:hover) {
		color: var(--sl-color-text-accent);
		background: none;
	}
	.page-tools :global(.page-actions[data-state='open'] .page-actions-trigger) {
		color: var(--sl-color-text-accent);
	}
	.page-tools :global(.trigger-icon) {
		opacity: 1;
	}
	.page-tools :global(.trigger-label),
	.page-tools :global(.trigger-chevron) {
		display: none;
	}
	/* The menu hangs from the bar, not the icon: anchored to the trigger it
	   would run off the start edge of a phone screen. */
	.page-tools :global(.page-actions) {
		position: static;
	}
	.page-tools :global(.page-actions-menu) {
		inset-inline: auto 0.5rem;
		margin-block-start: 0;
	}
	/* The summary's current-heading text would otherwise run under the overlay.
	   Width estimates: icon trigger plus padding; with the TextProv controls,
	   also the switch with its label and the info button. */
	.toc-host :global(#starlight__on-this-page--mobile) {
		padding-inline-end: 3.5rem;
	}
	.textprov-host :global(#starlight__on-this-page--mobile) {
		padding-inline-end: 15.5rem;
	}
	/* Phones: the switch label would leave the "On this page" toggle no room,
	   so it stays in the accessibility tree only. */
	@media (max-width: 39.99rem) {
		.page-tools :global(.textprov-compact .textprov-label) {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}
		.textprov-host :global(#starlight__on-this-page--mobile) {
			padding-inline-end: 8.5rem;
		}
	}

	/* Wide viewports: a static block at the top of the fixed right sidebar,
	   padded like the panel below it. The trigger keeps the plugin's look;
	   the menu opens from the start edge at the column's width, because the
	   sidebar clips horizontal overflow (overflow-y: auto on .right-sidebar). */
	@media (min-width: 72rem) {
		.page-tools {
			position: static;
			z-index: auto;
			block-size: auto;
			padding: 1rem var(--sl-sidebar-pad-x) 0;
			background: none;
			border: 0;
		}
		.page-tools .sl-container {
			display: block;
			width: calc(var(--sl-sidebar-width) - 2 * var(--sl-sidebar-pad-x));
			block-size: auto;
		}
		.page-tools :global(.page-actions-trigger) {
			inline-size: auto;
			block-size: 2.25rem;
			padding: 0 0.625rem;
			justify-content: flex-start;
			border: var(--llm-trigger-border);
			border-radius: var(--llm-radius);
			color: var(--llm-text);
		}
		.page-tools :global(.page-actions-trigger:hover) {
			color: var(--llm-text);
			background: var(--llm-border);
		}
		.page-tools :global(.page-actions[data-state='open'] .page-actions-trigger) {
			color: var(--llm-text);
		}
		.page-tools :global(.trigger-icon) {
			opacity: 0.8;
		}
		.page-tools :global(.trigger-label),
		.page-tools :global(.trigger-chevron) {
			display: revert;
		}
		.page-tools :global(.page-actions) {
			position: relative;
		}
		.page-tools :global(.page-actions-menu) {
			inset-inline: 0 auto;
			inline-size: 100%;
			margin-block-start: 0.375rem;
		}
	}
</style>
