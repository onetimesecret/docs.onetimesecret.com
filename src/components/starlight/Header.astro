---
import config from 'virtual:starlight/user-config';

import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from './SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import MobileMenuToggle from '@astrojs/starlight/components/MobileMenuToggle.astro';
import { Icon } from '@astrojs/starlight/components';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getNavLinks } from './nav-links';
import SectionCard from './SectionCard.astro';

/**
 * Render the `Search` component if Pagefind is enabled or the default search component has been overridden.
 */
const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const currentLocale = Astro.currentLocale ?? 'en';
const docsHome = getRelativeLocaleUrl(currentLocale, '/');
// The same four links render in the mobile drawer's section card
// (SectionCard.astro) below the 50rem breakpoint where .nav-links is hidden.
const navLinks = getNavLinks(currentLocale);

// Starlight only renders a hamburger and drawer on pages with a sidebar
// (template !== 'splash'). The homepage has neither, so on phones its header
// is a logo and a search icon with no way into the docs. On those pages the
// header renders Starlight's own MobileMenuToggle plus a short popover drawer
// carrying the section card. The toggle targets id="starlight__sidebar", which
// PageFrame only emits when hasSidebar is true, so there is no duplicate id.
const { hasSidebar } = Astro.locals.starlightRoute;

// The docs homepage is the one page where a reader may have wanted the app
// instead, so it alone gets a way back to onetimesecret.com beside the logo
// (which links to the docs home). Compare with trailing slashes normalised.
const trim = (p: string) => p.replace(/\/+$/, '');
const isDocsHome = !hasSidebar && trim(Astro.url.pathname) === trim(docsHome);
---

<div class:list={['header', 'sl-flex', { 'no-sidebar': !hasSidebar }]}>
	<div class="title-wrapper sl-flex">
    <SiteTitle />
    {
      isDocsHome && (
        <a href="https://onetimesecret.com/" class="site-link" aria-label="Go to onetimesecret.com">
          <span class="site-link-long" aria-hidden="true">Go to onetimesecret.com</span>
          <span class="site-link-short" aria-hidden="true">onetimesecret.com</span>
          <Icon name="external" size="0.875em" />
        </a>
      )
    }
	</div>
	<div class="sl-flex center-group print:hidden">
		{shouldRenderSearch && <Search />}
    <nav class="nav-links">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-label={Astro.locals.t(link.ariaKey)}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
          >
            {Astro.locals.t(link.labelKey)}
          </a>
        ))
      }
    </nav>
	</div>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
		<ThemeSelect />
		<LanguageSelect />
	</div>
	{
		!hasSidebar && (
			<ots-section-menu>
				{/* MobileMenuToggle styles `button:has(~ :popover-open)`, so the
				    popover must follow the button as a sibling. */}
				<MobileMenuToggle />
				<div popover="auto" id="starlight__sidebar" class="section-menu md:sl-hidden print:hidden">
					<SectionCard />
				</div>
			</ots-section-menu>
		)
	}
</div>

<script>
	// Mirrors the focus trapping PageFrame's sl-sidebar-pane applies to the full
	// drawer: while the section menu is open, the page body is inert so keyboard
	// and screen-reader focus stays within the header and menu.
	class SectionMenu extends HTMLElement {
		constructor() {
			super();
			const popover = this.querySelector<HTMLElement>('[popover]');
			popover?.addEventListener('toggle', (event) => {
				const open = (event as ToggleEvent).newState === 'open';
				document
					.querySelectorAll<HTMLElement>('.main-frame, .sl-skip-link')
					.forEach((el) => el.toggleAttribute('inert', open));
			});
		}
	}
	customElements.define('ots-section-menu', SectionMenu);
</script>

<style>
	.header {
		gap: var(--sl-nav-gap);
		justify-content: space-between;
		align-items: center;
		height: 100%;
	}

	.title-wrapper {
		/* Prevent long titles overflowing and covering the search and menu buttons on narrow viewports. */
		overflow: clip;
		/* Avoid clipping focus ring around link inside title wrapper. */
		padding: 0.25rem;
		margin: -0.25rem;
		min-width: 0;
		align-items: center;
		gap: 0.625rem;
	}

	/* Wayfinding link beside the logo, docs homepage only. A hairline rule
	   separates it from the wordmark, the same device the header uses between
	   the social icons and the theme controls. Resting ink is --sl-color-text
	   for the same contrast reason as .nav-links below. */
	.site-link {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding-inline-start: 0.625rem;
		border-inline-start: 1px solid var(--sl-color-hairline-light);
		line-height: 1.25rem;
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--sl-color-text);
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.15s ease;
	}
	.site-link:hover {
		color: var(--sl-color-white);
	}
	.site-link-long {
		display: none;
	}
	/* Phones: logo, search and menu share ~375px, so only the host name fits;
	   under 22rem even that goes and the glyph alone remains (the aria-label
	   keeps the full name). */
	@media (max-width: 21.99rem) {
		.site-link-short {
			display: none;
		}
	}

	.right-group,
	.social-icons {
		gap: 1rem;
		align-items: center;
	}
	.social-icons::after {
		content: '';
		height: 1.5rem;
		border-inline-end: 1px solid var(--sl-color-hairline-light);
	}

  .center-group {
    align-items: center;
    gap: 0.5rem;
  }

  .nav-links {
    display: none;
    gap: 0.125rem;
    align-items: center;
    margin-left: 0.25rem;
  }

  /* --sl-color-gray-3 is only 4.35:1 on the light nav background, so the resting
     state uses --sl-color-text and hover steps up to --sl-color-white. Same
     resting/hover pairing Starlight uses for sidebar links, and it keeps a
     visible hover step in both themes. */
  .nav-links a {
    color: var(--sl-color-text);
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 0.3rem 0.625rem;
    border-radius: 6px;
    transition: color 0.15s ease, background-color 0.15s ease;
    white-space: nowrap;
  }

  .nav-links a:hover {
    color: var(--sl-color-white);
    background: color-mix(in srgb, var(--sl-color-text) 7%, transparent);
  }

  /* 50rem is Starlight's drawer breakpoint. Below it the drawer's section card
     (SectionCard.astro) takes over, so the two never show at the same time. */
  @media (min-width: 50rem) {
    .nav-links {
      display: flex;
    }
    .site-link {
      font-size: 0.8125rem;
    }
    .site-link-long {
      display: inline;
    }
    .site-link-short {
      display: none;
    }
  }

  /* Sidebar-less pages: PageFrame reserves room for the fixed menu button only
     under [data-has-sidebar], so reserve it here instead or the button sits on
     top of the search icon. Same formula PageFrame uses, minus the nav padding
     the outer header already applies. */
  @media (max-width: 49.99rem) {
    .header.no-sidebar {
      padding-inline-end: calc(var(--sl-nav-gap) + var(--sl-menu-button-size));
    }
  }

  /* Short drawer for sidebar-less pages. Geometry copied from PageFrame's
     .sidebar-pane so it opens in the same place as the full drawer; the UA
     popover defaults (auto margins, border, fit-content size) are reset. */
  .section-menu {
    border: unset;
    padding: 1rem var(--sl-sidebar-pad-x);
    margin: 0;
    height: unset;
    color: unset;
    position: fixed;
    z-index: var(--sl-z-index-menu);
    inset-block: var(--sl-nav-height) 0;
    inset-inline-start: 0;
    width: 100%;
    background-color: var(--sl-color-black);
    overflow-y: auto;
  }

	@media (min-width: 50rem) {
		:global(:root[data-has-sidebar]) {
			--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
		}
		:global(:root:not([data-has-toc])) {
			--__toc-width: 0rem;
		}
		.header {
			--__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
			--__main-column-fr: calc(
				(
						100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
							(2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
							var(--sl-content-width)
					) / 2
			);
			display: grid;
			grid-template-columns:
        /* 1 (site title): runs up until the main content column's left edge or the width of the title, whichever is the largest  */
				minmax(
					calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))),
					auto
				)
				/* 2 (search box): all free space that is available. */
				1fr
				/* 3 (right items): use the space that these need. */
				auto;
			align-content: center;
		}
	}
</style>
