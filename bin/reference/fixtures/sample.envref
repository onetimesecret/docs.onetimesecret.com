# .env.reference
#
# Fixture - Full Environment Variable Reference
#
# This file documents every supported environment variable.
#
# Variables marked:
#   * [derived] are generated by `rake ots:init` via HKDF from SECRET.
#
# A trailing `# Since vX.Y.Z` records the release a variable first shipped in;
# `# Since unreleased` means it ships in the next one.

# ═══════════════════════════════════════════════════════════
#  SAMPLE SECTION
# ═══════════════════════════════════════════════════════════
# Section prose: belongs to the section, not to the first variable.

# Active assignment, empty value. Unset and empty are different things and
# this is the empty one.
ACTIVE_EMPTY=

# Active assignment with a value and a release annotation.
ACTIVE_VALUE=production  # Since v0.26.0

# Commented assignment whose prose declares a default outright.
# Default: 3600 (1 hour).
#COMMENTED_TTL=3600  # Since v0.24.0

# [derived] Tagged, and annotated as unreleased.
#TAGGED_KEY=  # Since unreleased

# Quoted value carrying a hash that is part of the value.
#QUOTED_HASH='#3B82F6'

# Quoted value carrying equals signs and a colon.
#URL_WITH_EQUALS='redis://host:6379/0?timeout=5&other=1'

# Enumerated default: warn (default) | enforce | off.
#ENUM_MODE=warn

# Only applies when
# ENUM_MODE=enforce, which is prose mentioning a variable at the start of a
# comment line and declaring nothing.
#ENUM_NOTE=

# Ambiguous parenthetical: all enabled methods are shown (default).
#AMBIGUOUS_DEFAULT=

# Prose that would be Markdown if it were not fenced: *starred*, _under_,
# [derived] reads as a link reference, a pipe | mid-sentence, <b>html</b>,
# an & ampersand, and a fence ``` inside the comment.
#MARKDOWN_HOSTILE=keep|me

# Inert. Nothing in this pipeline evaluates a value.
#SHELL_LOOKALIKE=$(rm -rf /)
#BACKTICK_LOOKALIKE=`rm -rf /`
#BRACE_LOOKALIKE=${HOME}/nope

# A value continued onto a second line with a trailing backslash.
MULTILINE_VALUE=first \
second

# This comment block is separated from the assignment below by a blank line,
# so it is not this variable's description.

#DETACHED_PROSE=value

# Malformed: the opening quote never closes.
#MALFORMED_QUOTE="oops

# Default when unset: "Secure Links" (neutral).
#PHRASED_DEFAULT=

# ═══════════════════════════════════════════════════════════
#  DEVELOPMENT ONLY
# ═══════════════════════════════════════════════════════════

# Uncomment for local development
#ACTIVE_VALUE=development
#DEV_ONLY_FLAG=1
