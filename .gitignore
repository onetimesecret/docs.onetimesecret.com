# Astro dev/build outputs
.astro
.serena
dist
# Astro's generated data directory at the repo root. The negation keeps the
# checked-in reference records under src/data/ visible.
data
!src/data/

# Node dependencies
node_modules

# npm lockfile is not used — this repo installs/builds with pnpm only.
# Removing it keeps Dependabot/Renovate from scanning a second, drifting manifest.
package-lock.json

# Logs
logs
*.log
*.txt
!src/fonts/**/OFL.txt
!tools/fonts/requirements.txt
!tools/requirements.txt

# Misc
.DS_Store
.fleet
.idea
.prompts
.crossnote
.lycheecache
billing.yaml
tmp

# Local env files
.env
.env.*
*.env
*.env-*
.envrc
!.env.example
# One pinned upstream snapshot, tracked on purpose: it is the input the
# reference generator reads and the thing reviewers diff. Narrow by design —
# every other .env.* stays ignored.
!vendor/onetimesecret/.env.reference
.ruby-version
.commit_hash.txt

# Shared agent instructions: of .claude/, only the explicit Claude authoring
# command is tracked.
.claude/*
!.claude/commands/
.claude/commands/*
!.claude/commands/textprov.md
__pycache__/
.venv/

# VSC
.history

# Docker
Dockerfile.*
!Dockerfile.example

# Jupyter
.ipynb_checkpoints
*.ipynb
.qodo
