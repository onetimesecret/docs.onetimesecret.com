# Astro dev/build outputs
.astro
.serena
dist
# Astro's generated data directory at the repo root. The negation keeps the
# checked-in reference records under src/data/ visible.
data
!src/data/

# Node dependencies
node_modules

# npm lockfile is not used — this repo installs/builds with pnpm only.
# Removing it keeps Dependabot/Renovate from scanning a second, drifting manifest.
package-lock.json

# Logs
logs
*.log
*.txt
!src/fonts/**/OFL.txt
!tools/fonts/requirements.txt
!tools/requirements.txt
!public/llms.txt

# Misc
.DS_Store
.fleet
.idea
.prompts
.crossnote
.lycheecache
billing.yaml
tmp

# Local env files
.env
.env.*
*.env
*.env-*
.envrc
!.env.example

.ruby-version
.commit_hash.txt

# Shared agent instructions: of .claude/, only the explicit Claude authoring
# command is tracked.
.claude/*
!.claude/commands/
.claude/commands/*
!.claude/commands/textprov.md
__pycache__/
# Both forms: a worktree helper that symlinks a shared environment creates
# `.venv` as a symlink, which `.venv/` does not match, and one such symlink
# was committed once already.
.venv
.venv/

# VSC
.history

# Docker
Dockerfile.*
!Dockerfile.example

# Jupyter
.ipynb_checkpoints
*.ipynb
.qodo
