{
  "name": "docs",
  "type": "module",
  "version": "2.2.1",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "astro dev --host",
    "start": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "astro": "astro",
    "check:nav": "node bin/check-nav.mjs",
    "check:orphans": "node bin/check-orphans.mjs",
    "check:frontmatter": "node bin/check-frontmatter.mjs",
    "check:locales": "node bin/check-locales.mjs",
    "check:contrast": "node bin/check-contrast.mjs",
    "check:textprov": "node bin/check-textprov.mjs",
    "check:reference:html": "node bin/check-reference-html.mjs",
    "check:types": "astro sync && tsc --noEmit",
    "reference:check": "node bin/reference.mjs check",
    "check:links": "./bin/check-links.sh",
    "check:links:malformed": "./bin/check-malformed-links.sh",
    "check:links:get": "./bin/check-links.sh --get --external",
    "check:links:external": "./bin/check-links.sh --external",
    "check:links:verbose": "./bin/check-links.sh --verbose",
    "fix:links": "./bin/fix-links.sh",
    "fix:links:apply": "./bin/fix-links.sh --apply",
    "translate:prepare": "echo 'e.g. ./src/content/docs/$CODE' && ./bin/translation-pluribus-util prepare",
    "translate:combine": "./bin/translation-pluribus-util combine",
    "translate:split": "./bin/translation-pluribus-util split",
    "translate:restore": "./bin/translation-pluribus-util restore",
    "generate:for-translators": "./bin/generate-for-translators all"
  },
  "dependencies": {
    "@astrojs/markdoc": "^2.1.1",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/starlight": "^0.42.7",
    "@astrojs/starlight-markdoc": "^0.7.0",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@astrojs/vue": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "accessible-astro-components": "^5.8.1",
    "astro": "^7.4.2",
    "devalue": "^6.0.3",
    "hast-util-select": "^6.0.4",
    "parse5": "^8.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-stringify": "^11.0.0",
    "sharp": "^0.35.5",
    "sitemap": "10.0.0",
    "starlight-llm-actions": "0.13.0",
    "tailwindcss": "^4.3.3",
    "textprov": "0.2.1",
    "unist-util-remove": "^4.0.0",
    "vue": "^3.5.44",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/jsdom": "^30.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "spotnote": "^0.5.0",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vitest": "^5.0.5"
  }
}
