{
  "name": "docs",
  "type": "module",
  "version": "2.1.1",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "astro dev --host",
    "start": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "astro": "astro",
    "check:nav": "node bin/check-nav.mjs",
    "check:orphans": "node bin/check-orphans.mjs",
    "check:locales": "node bin/check-locales.mjs",
    "check:contrast": "node bin/check-contrast.mjs",
    "check:links": "./bin/check-links.sh",
    "check:links:malformed": "./bin/check-malformed-links.sh",
    "check:links:get": "./bin/check-links.sh --get --external",
    "check:links:external": "./bin/check-links.sh --external",
    "check:links:verbose": "./bin/check-links.sh --verbose",
    "fix:links": "./bin/fix-links.sh",
    "fix:links:apply": "./bin/fix-links.sh --apply",
    "translate:prepare": "echo 'e.g. ./src/content/docs/$CODE' && ./bin/translation-pluribus-util prepare",
    "translate:combine": "./bin/translation-pluribus-util combine",
    "translate:split": "./bin/translation-pluribus-util split",
    "translate:restore": "./bin/translation-pluribus-util restore",
    "generate:for-translators": "./bin/generate-for-translators all"
  },
  "dependencies": {
    "@astrojs/markdoc": "^2.0.5",
    "@astrojs/react": "^6.0.1",
    "@astrojs/starlight": "^0.41.5",
    "@astrojs/starlight-markdoc": "^0.7.0",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@astrojs/vue": "^7.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "accessible-astro-components": "^5.4.0",
    "astro": "^7.1.4",
    "devalue": "^5.8.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hotkeys-hook": "^5.3.3",
    "sharp": "^0.35.3",
    "sitemap": "9.0.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
